# EditingSystem documentation site. Build from this folder with `lunet build`.
extend "lunet-io/templates"

# Keep the Tomlyn-inspired developer documentation experience dark by default.
template_theme_default_mode = "dark"

site_project_baseurl = "https://yoshihiroito.github.io"
site_project_basepath = "/EditingSystem"
site_project_name = "EditingSystem"
site_project_description = "Undo/redo for .NET with source-generated undoable properties, batching, and collection support."
site_project_package_id = "Jewelry.EditingSystem"
site_project_github_user = "YoshihiroIto"
site_project_github_repo = "EditingSystem"
site_project_owner_name = "Yoshihiro Ito"
site_project_owner_alias = "yoiyoi322"
site_project_owner_url = "https://github.com/YoshihiroIto"
site_project_logo_path = "/img/EditingSystem.png"
site_project_favicon_path = "/img/EditingSystem.png"

site_project_init
html.head.metas.add '<script>if (window.location.pathname.includes("/ja/")) { document.documentElement.lang = "ja"; document.documentElement.classList.add("lang-ja"); }</script>'
html.head.metas.add '<link rel="stylesheet" href="' + site_project_basepath + '/css/editingsystem.css?v=20260901-0203">'
html.head.metas.add '<script>document.addEventListener("DOMContentLoaded", () => { document.querySelectorAll(".breadcrumb-link").forEach((link) => { if (link.getAttribute("href") !== "/ja/docs/menu.yml") return; const setLink = (target, href, iconClass, label) => { target.href = href; const icon = document.createElement("i"); icon.className = iconClass; icon.setAttribute("aria-hidden", "true"); target.replaceChildren(icon, document.createTextNode(" " + label)); }; const path = window.location.pathname.replace(/\\/+$/, ""); if (path === "/EditingSystem/ja/docs") { setLink(link, "/EditingSystem/ja/", "bi bi-house-door", "ホーム"); return; } const homeItem = document.createElement("li"); homeItem.className = "breadcrumb-item"; const homeLink = document.createElement("a"); homeLink.className = "breadcrumb-link"; setLink(homeLink, "/EditingSystem/ja/", "bi bi-house-door", "ホーム"); homeItem.append(homeLink); link.closest(".breadcrumb")?.prepend(homeItem); setLink(link, "/EditingSystem/ja/docs/", "bi bi-book", "ガイド"); }); });</script>'

# Generate the English public API reference directly from the package projects.
# Per-project target frameworks keep the multi-targeted core and netstandard
# CommunityToolkit integration on supported build targets.
with api.dotnet
    title = "EditingSystem API Reference"
    path = "/api"
    menu_name = "api"
    menu_title = "API Reference"
    config = "Release"
    projects = [
        {
            name: "Jewelry.EditingSystem",
            path: "../EditingSystem/Jewelry.EditingSystem/Jewelry.EditingSystem.csproj",
            properties: { TargetFramework: "net10.0" }
        },
        {
            name: "Jewelry.EditingSystem.CommunityToolkit.Mvvm",
            path: "../EditingSystem/Jewelry.EditingSystem.CommunityToolkit.Mvvm/Jewelry.EditingSystem.CommunityToolkit.Mvvm.csproj",
            properties: { TargetFramework: "netstandard2.0" }
        }
    ]
end

# Dart Sass already compiles the theme's SCSS. Avoid a second Sass pass during
# bundle minification so the same build works on Windows and GitHub Actions.
with bundle
    minify = false
end
